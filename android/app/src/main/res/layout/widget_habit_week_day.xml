<?xml version="1.0" encoding="utf-8"?>
<!-- One column of the week: the weekday letter and a circle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/day_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/onest_medium"
        android:includeFontPadding="false"
        android:textSize="10sp" />

    <FrameLayout
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/day_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/widget_check_ring" />

        <ImageView
            android:id="@+id/day_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/widget_check_fill"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/day_mark"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/widget_ic_check"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

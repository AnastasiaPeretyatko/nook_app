<?xml version="1.0" encoding="utf-8"?>
<!-- The "Сегодня" home-screen widget.

     Only the view types RemoteViews allows appear here: FrameLayout,
     LinearLayout, TextView, ImageView. Everything that carries a colour is an
     ImageView over a shape drawable rather than a background, because a
     background cannot be tinted through RemoteViews on API 24 — see
     res/drawable/widget_card.xml.

     The rows are not in this file. They are inflated one at a time from
     widget_today_row.xml and added into @id/widget_rows, which is what lets each
     row carry click targets of its own: ids inside a layout are only unique
     within it, so five copies of the same row in one tree could not be told
     apart. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_bold"
                android:includeFontPadding="false"
                android:text="@string/widget_title"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:includeFontPadding="false"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/widget_calendar"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_ic_calendar" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_divider_top"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_hairline" />

        <LinearLayout
            android:id="@+id/widget_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/widget_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:fontFamily="@font/nunito_semibold"
            android:includeFontPadding="false"
            android:textSize="12sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_divider_bottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_hairline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_add"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_add_icon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_ic_plus" />

                <TextView
                    android:id="@+id/widget_add_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/nunito_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/widget_add_task"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:includeFontPadding="false"
                android:textSize="12sp" />

            <!-- The progress bar, in two layers so that both of its colours can
                 follow the theme: a groove that is a tinted shape, and a fill
                 that is a bitmap drawn white and tinted with the accent. The
                 fill has to be a bitmap because its width is the day's progress,
                 and RemoteViews cannot resize a view before API 31. -->
            <FrameLayout
                android:id="@+id/widget_progress"
                android:layout_width="66dp"
                android:layout_height="7dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/widget_progress_track"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_progress_track" />

                <ImageView
                    android:id="@+id/widget_progress_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

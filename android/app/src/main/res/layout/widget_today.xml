<?xml version="1.0" encoding="utf-8"?>
<!-- The "Сегодня" home-screen widget, one design from 4×2 up to 4×4: the number
     of rows follows the height, and the "Добавить задачу" line appears only
     when there is room for it.

     Only the view types RemoteViews allows appear here: FrameLayout,
     LinearLayout, TextView, ImageView. Everything that carries a colour is an
     ImageView over a shape drawable rather than a background, because a
     background cannot be tinted through RemoteViews on API 24 — see
     res/drawable/widget_card.xml.

     The rows are not in this file. They are inflated one at a time from
     widget_today_row.xml and added into @id/widget_rows, which is what lets each
     row carry click targets of its own: ids inside a layout are only unique
     within it, so five copies of the same row in one tree could not be told
     apart. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/onest_semibold"
                android:includeFontPadding="false"
                android:text="@string/widget_title"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/onest_medium"
                android:includeFontPadding="false"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/widget_add"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/widget_add_disc"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_check_fill" />

                <ImageView
                    android:id="@+id/widget_add_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_ic_plus" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_add_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/onest_medium"
                android:includeFontPadding="false"
                android:text="@string/widget_add_task"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

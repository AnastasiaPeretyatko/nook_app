<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows for "Привычка с неделей" (4×2): the real card with sample content from
     WidgetsLight.dc.html, colours fixed (the light palette). Nothing here is bound
     at runtime; the real widget is widget_habit_week.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/onest_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_meditation"
                    android:textColor="#1B2230"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/onest_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_week_sub"
                    android:textColor="#5F6878"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_pill"
                    android:tint="#1B2230" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/onest_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="@string/widget_habit_mark"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/onest_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_mon"
                    android:textColor="#5F6878"
                    android:textSize="10sp" />
                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_check_fill"
                    android:tint="#2B6E53" />
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                        android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_ic_check" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/onest_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_tue"
                    android:textColor="#5F6878"
                    android:textSize="10sp" />
                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_check_fill"
                    android:tint="#2B6E53" />
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                        android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_ic_check" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/onest_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_wed"
                    android:textColor="#5F6878"
                    android:textSize="10sp" />
                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_check_fill"
                    android:tint="#E6EAF4" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/onest_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_thu"
                    android:textColor="#5F6878"
                    android:textSize="10sp" />
                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_check_fill"
                    android:tint="#2B6E53" />
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                        android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_ic_check" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/onest_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_fri"
                    android:textColor="#5F6878"
                    android:textSize="10sp" />
                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_check_ring"
                    android:tint="#5B6DCB" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/onest_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_sat"
                    android:textColor="#5F6878"
                    android:textSize="10sp" />
                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_check_ring"
                    android:tint="#C9D0DE" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/onest_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_sun"
                    android:textColor="#5F6878"
                    android:textSize="10sp" />
                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_check_ring"
                    android:tint="#C9D0DE" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

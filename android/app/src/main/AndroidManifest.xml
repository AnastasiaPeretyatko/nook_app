<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Habit timers post an ongoing entry to the notification shade and an
         alert for the moment a run finishes. POST_NOTIFICATIONS is the runtime
         permission every notification needs from Android 13 on, and the boot
         permission is what lets a pending alert survive a reboot.

         SCHEDULE_EXACT_ALARM is declared but never requested from code: the
         request throws the user out into a system settings screen, which is too
         rude for a convenience. Until it is offered as a deliberate opt-in, the
         alert falls back to an inexact alarm — a little late rather than never.

         VIBRATE and POST_NOTIFICATIONS are also declared by
         flutter_local_notifications itself and merge with these. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Signing in talks to Supabase, and that is the app's only network call.
         The Flutter template declares INTERNET in src/debug for hot reload, so
         a debug build had it all along and a release build would not — this is
         the declaration that makes the account work on a real APK. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="Nook"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Where Google sends the browser back after an OAuth sign-in.
                 The scheme is reverse-DNS and not the applicationId
                 (com.yourname.todo_app): a URI scheme may hold only letters,
                 digits, '+', '-' and '.', so the underscore rules that one
                 out, and Android silently fails to match a filter whose
                 scheme is invalid. It is spelled again
                 as `authRedirectUrl` in lib/settings/supabase_config.dart, in
                 ios/Runner/Info.plist, and in the Supabase dashboard's
                 Redirect URLs — all four have to agree.

                 android:launchMode="singleTop" above is what delivers this to
                 the running activity instead of starting a second one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="io.supabase.nook" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Delivers the scheduled "time is up" alert, and re-registers the
             pending ones after a reboot or an app update — without the boot
             receiver a timer scheduled before a restart would never fire. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
